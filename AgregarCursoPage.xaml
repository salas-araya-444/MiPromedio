<ContentPage x:Class="MiPromedio.AgregarCursoPage"
             Title="Agregar curso"
             BackgroundColor="{StaticResource FondoApp}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- Título de la pantalla -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Nuevo curso"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource AzulOscuro}" />
                <Label Text="Ingrese los datos del curso para calcular su promedio."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <!-- Tarjeta blanca con el formulario -->
            <Border BackgroundColor="White"
                    Stroke="{StaticResource Secondary}"
                    StrokeThickness="1"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <!-- Campo 1: nombre del curso -->
                    <Label Text="Nombre del curso"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Entry x:Name="EntryNombre"
                           Placeholder="Ej: Desarrollo de Software IV" />

                    <!-- Campo 2: créditos (solo números) -->
                    <Label Text="Créditos"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Margin="0,10,0,0" />
                    <Entry x:Name="EntryCreditos"
                           Placeholder="Ej: 4"
                           Keyboard="Numeric" />

                    <!-- Campo 3: nota final de 0 a 100 -->
                    <Label Text="Nota final (0 a 100)"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Margin="0,10,0,0" />
                    <Entry x:Name="EntryNota"
                           Placeholder="Ej: 85"
                           Keyboard="Numeric" />

                    <!-- Mensaje de error, empieza oculto y se muestra si algo está mal -->
                    <Label x:Name="LabelError"
                           TextColor="#D64545"
                           FontSize="14"
                           IsVisible="False"
                           Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Border>

            <!-- Botón para guardar el curso -->
            <Button Text="Guardar curso"
                    Clicked="OnGuardarClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50" />

            <!-- Botón para regresar sin guardar -->
            <Button Text="Cancelar"
                    Clicked="OnCancelarClicked"
                    BackgroundColor="White"
                    TextColor="{StaticResource Primary}"
                    BorderColor="{StaticResource Primary}"
                    BorderWidth="1"
                    CornerRadius="12"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>